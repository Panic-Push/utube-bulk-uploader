<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="UTubeBulkUploader.Views.PreviewPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:h="using:UTubeBulkUploader.Helpers"
    xmlns:vm="using:UTubeBulkUploader.ViewModels"
    Background="Transparent">

    <Page.Resources>
        <!-- One video: current name → new name -->
        <DataTemplate x:Key="ClipTemplate" x:DataType="vm:ClipViewModel">
            <Grid ColumnSpacing="12" Padding="0,6" ToolTipService.ToolTip="{x:Bind FullPath}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="32" />
                    <ColumnDefinition Width="1.4*" MinWidth="120" />
                    <ColumnDefinition Width="16" />
                    <ColumnDefinition Width="3.4*" MinWidth="220" />
                    <ColumnDefinition Width="104" />
                    <ColumnDefinition Width="64" />
                    <ColumnDefinition Width="1.6*" />
                </Grid.ColumnDefinitions>
                <CheckBox IsChecked="{x:Bind Included, Mode=TwoWay}" IsEnabled="{x:Bind CanToggle, Mode=OneWay}"
                          MinWidth="0" VerticalAlignment="Center" AutomationProperties.Name="Rename this clip" />
                <TextBlock Grid.Column="1" Text="{x:Bind CurrentName, Mode=OneWay}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"
                           Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                <FontIcon Grid.Column="2" Glyph="&#xE72A;" FontSize="12" Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
                <TextBlock Grid.Column="3" Text="{x:Bind NewName, Mode=OneWay}" VerticalAlignment="Center"
                           TextTrimming="CharacterEllipsis" Opacity="{x:Bind NewNameOpacity, Mode=OneWay}"
                           IsTextSelectionEnabled="True" />
                <TextBlock Grid.Column="4" Text="{x:Bind DateText}" VerticalAlignment="Center" ToolTipService.ToolTip="{x:Bind DateTip}"
                           Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
                <TextBlock Grid.Column="5" Text="{x:Bind Size}" VerticalAlignment="Center" HorizontalAlignment="Right"
                           Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
                <StackPanel Grid.Column="6" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center"
                            Visibility="{x:Bind h:Ui.Show(HasNote), Mode=OneWay}" ToolTipService.ToolTip="{x:Bind Note, Mode=OneWay}">
                    <FontIcon Glyph="&#xEA39;" FontSize="14" Foreground="{ThemeResource SystemFillColorCriticalBrush}"
                              Visibility="{x:Bind h:Ui.Show(IsError), Mode=OneWay}" />
                    <FontIcon Glyph="&#xE7BA;" FontSize="14" Foreground="{ThemeResource SystemFillColorCautionBrush}"
                              Visibility="{x:Bind h:Ui.Show(IsWarning), Mode=OneWay}" />
                    <FontIcon Glyph="&#xE930;" FontSize="14" Foreground="{ThemeResource SystemFillColorSuccessBrush}"
                              Visibility="{x:Bind h:Ui.Show(IsInfo), Mode=OneWay}" />
                    <TextBlock Text="{x:Bind Note, Mode=OneWay}" TextTrimming="CharacterEllipsis" Style="{StaticResource CaptionTextBlockStyle}"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}" VerticalAlignment="Center" />
                </StackPanel>
            </Grid>
        </DataTemplate>

        <!-- One folder inside a story: editable name (sub-folders), editable date, then its clips -->
        <DataTemplate x:Key="FolderTemplate" x:DataType="vm:FolderViewModel">
            <StackPanel Spacing="4" Margin="{x:Bind Indent}" Opacity="{x:Bind Dim, Mode=OneWay}">
                <Grid ColumnSpacing="10" Margin="0,8,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                        <FontIcon Glyph="&#xE8B7;" FontSize="16" Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                  Visibility="{x:Bind h:Ui.Show(IsSub)}" />
                        <TextBox Text="{x:Bind Name, Mode=TwoWay}" Width="220" Visibility="{x:Bind h:Ui.Show(IsSub)}"
                                 KeyDown="OnCommitKey" AutomationProperties.Name="Sub-folder name in titles"
                                 ToolTipService.ToolTip="Change this part of the titles. The folder on disk keeps its name." />
                        <TextBlock Text="{x:Bind Heading}" Style="{StaticResource BodyStrongTextBlockStyle}" VerticalAlignment="Center"
                                   Visibility="{x:Bind h:Ui.Show(IsStory)}" />
                    </StackPanel>
                    <TextBox Grid.Column="1" Text="{x:Bind DateText, Mode=TwoWay}" Width="104" PlaceholderText="dd.mm.yy"
                             Visibility="{x:Bind h:Ui.Show(HasClips)}"
                             KeyDown="OnCommitKey" AutomationProperties.Name="Date for every clip in this folder"
                             Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                             ToolTipService.ToolTip="Date for every clip in this folder. Type it like 26.10.26. Clear it to go back to the date from the clips." />
                    <TextBlock Grid.Column="2" VerticalAlignment="Center" Style="{StaticResource CaptionTextBlockStyle}"
                               Foreground="{ThemeResource SystemFillColorCriticalBrush}" Text="{x:Bind DateError, Mode=OneWay}"
                               Visibility="{x:Bind h:Ui.Show(HasDateError), Mode=OneWay}" />
                    <StackPanel Grid.Column="3" Orientation="Horizontal" Spacing="12" VerticalAlignment="Center">
                        <TextBlock Text="{x:Bind RenameNote, Mode=OneWay}" Style="{StaticResource CaptionTextBlockStyle}"
                                   Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
                        <TextBlock Text="{x:Bind DateNote, Mode=OneWay}" Style="{StaticResource CaptionTextBlockStyle}"
                                   Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
                        <TextBlock Text="{x:Bind EmptyNote, Mode=OneWay}" Style="{StaticResource CaptionTextBlockStyle}"
                                   Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
                    </StackPanel>
                    <Button Grid.Column="4" Style="{StaticResource SubtleButtonStyleUB}" Click="OnSortFolder"
                            Visibility="{x:Bind h:Ui.Show(HasClips)}" ToolTipService.ToolTip="Order these clips by recording time">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <FontIcon Glyph="&#xE8CB;" FontSize="14" />
                            <TextBlock Text="Sort by time" />
                        </StackPanel>
                    </Button>
                </Grid>
                <ListView ItemsSource="{x:Bind Clips}" ItemTemplate="{StaticResource ClipTemplate}"
                          Visibility="{x:Bind h:Ui.Show(HasClips)}"
                          SelectionMode="None" CanReorderItems="True" CanDragItems="True" AllowDrop="True"
                          ScrollViewer.VerticalScrollMode="Disabled" ScrollViewer.VerticalScrollBarVisibility="Disabled"
                          Margin="-12,0,0,0" AutomationProperties.Name="Clips. Drag to change the order." />
            </StackPanel>
        </DataTemplate>

        <!-- One story (an added folder) -->
        <DataTemplate x:Key="StoryTemplate" x:DataType="vm:StoryViewModel">
            <Border Style="{StaticResource CardStyle}" Padding="20,16">
                <StackPanel Opacity="{x:Bind Dim, Mode=OneWay}">
                    <Grid ColumnSpacing="12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <FontIcon Glyph="&#xE8D5;" FontSize="20" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" VerticalAlignment="Center" />
                        <TextBox Grid.Column="1" Text="{x:Bind Name, Mode=TwoWay}" MinWidth="220" MaxWidth="360" FontWeight="SemiBold"
                                 KeyDown="OnCommitKey" AutomationProperties.Name="Story name"
                                 ToolTipService.ToolTip="Story name used in every title below. The folder on disk keeps its name." />
                        <StackPanel Grid.Column="2" VerticalAlignment="Center" Spacing="2">
                            <TextBlock Text="{x:Bind Counts, Mode=OneWay}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" />
                            <TextBlock Text="{x:Bind RenameNote, Mode=OneWay}" Style="{StaticResource CaptionTextBlockStyle}"
                                       Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
                        </StackPanel>
                        <Button Grid.Column="3" Style="{StaticResource SubtleButtonStyleUB}" Click="OnRemoveStory"
                                ToolTipService.ToolTip="Remove from preview (nothing on disk changes)" AutomationProperties.Name="Remove story">
                            <FontIcon Glyph="&#xE711;" FontSize="14" />
                        </Button>
                    </Grid>
                    <ItemsControl ItemsSource="{x:Bind Folders}" ItemTemplate="{StaticResource FolderTemplate}" Margin="32,4,0,0" />
                </StackPanel>
            </Border>
        </DataTemplate>
    </Page.Resources>

    <Grid Margin="{StaticResource PageMargin}" RowSpacing="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Grid>
            <StackPanel Spacing="4">
                <TextBlock Text="Preview" Style="{StaticResource TitleTextBlockStyle}" />
                <TextBlock Text="{x:Bind Vm.Summary, Mode=OneWay}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
            </StackPanel>
            <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right" VerticalAlignment="Bottom">
                <ProgressRing x:Name="BusyRing" Width="20" Height="20" IsActive="False" Visibility="Collapsed" />
                <Button Click="OnAddMore">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <FontIcon Glyph="&#xE710;" FontSize="14" />
                        <TextBlock Text="Add folders" />
                    </StackPanel>
                </Button>
                <Button x:Name="RenameButton" Style="{StaticResource AccentButtonStyle}" Click="OnRename" IsEnabled="{x:Bind Vm.CanRename, Mode=OneWay}">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <FontIcon Glyph="&#xE8AC;" FontSize="14" />
                        <TextBlock Text="Rename files" />
                    </StackPanel>
                </Button>
            </StackPanel>
        </Grid>

        <InfoBar Grid.Row="1" x:Name="Message" IsOpen="False" IsClosable="True">
            <InfoBar.ActionButton>
                <Button x:Name="UndoButton" Content="Undo this rename" Click="OnUndoLast" Visibility="Collapsed" />
            </InfoBar.ActionButton>
        </InfoBar>

        <InfoBar Grid.Row="2" x:Name="Tip" IsOpen="{x:Bind Vm.HasStories, Mode=OneWay}" IsClosable="True" Severity="Informational"
                 Message="Check names and dates, then rename. Edit a story or sub-folder name to change the titles (the folders on disk keep their names). Type over the grey dd.mm.yy to change every clip in that folder. Drag clips to change their order; untick clips to skip them." />

        <ScrollViewer Grid.Row="3" Visibility="{x:Bind h:Ui.Show(Vm.HasStories), Mode=OneWay}">
            <ItemsControl ItemsSource="{x:Bind Vm.Stories}" ItemTemplate="{StaticResource StoryTemplate}" Margin="0,0,12,0">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <StackPanel Spacing="12" />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
            </ItemsControl>
        </ScrollViewer>

        <StackPanel Grid.Row="3" VerticalAlignment="Center" HorizontalAlignment="Center" Spacing="12"
                    Visibility="{x:Bind h:Ui.Show(Vm.IsEmpty), Mode=OneWay}">
            <FontIcon Glyph="&#xE8B7;" FontSize="40" Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
            <TextBlock Text="Nothing to preview yet" Style="{StaticResource SubtitleTextBlockStyle}" HorizontalAlignment="Center" />
            <TextBlock Text="Add story folders on the Home page." Foreground="{ThemeResource TextFillColorSecondaryBrush}" HorizontalAlignment="Center" />
            <Button Content="Add folders" Click="OnAddMore" HorizontalAlignment="Center" Style="{StaticResource AccentButtonStyle}" />
        </StackPanel>
    </Grid>
</Page>
