<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="UTubeBulkUploader.Views.HomePage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:h="using:UTubeBulkUploader.Helpers"
    xmlns:vm="using:UTubeBulkUploader.ViewModels"
    Background="Transparent">

    <ScrollViewer>
        <StackPanel Margin="{StaticResource PageMargin}" Spacing="12" MaxWidth="1100" HorizontalAlignment="Stretch">
            <TextBlock x:Name="Greeting" Style="{StaticResource TitleTextBlockStyle}" Margin="0,0,0,8" />

            <InfoBar x:Name="Message" IsOpen="False" IsClosable="True" />

            <!-- Drop zone: drag one or more folders here from File Explorer -->
            <Grid x:Name="DropZone" MinHeight="220" AllowDrop="True" Background="Transparent"
                  DragOver="OnDragOver" DragLeave="OnDragLeave" Drop="OnDrop" Tapped="OnDropZoneTapped"
                  AutomationProperties.Name="Add story folders">
                <Rectangle x:Name="DropBorder" RadiusX="8" RadiusY="8" StrokeThickness="1.5" StrokeDashArray="4,3"
                           Stroke="{ThemeResource ControlStrongStrokeColorDefaultBrush}"
                           Fill="{ThemeResource CardBackgroundFillColorDefaultBrush}" />
                <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Spacing="8" Padding="24">
                    <FontIcon x:Name="DropIcon" Glyph="&#xE838;" FontSize="40" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" />
                    <ProgressRing x:Name="ScanRing" Width="40" Height="40" IsActive="False" Visibility="Collapsed" />
                    <TextBlock x:Name="DropTitle" Text="Drop story folders here" HorizontalAlignment="Center"
                               Style="{StaticResource SubtitleTextBlockStyle}" />
                    <TextBlock x:Name="DropSub" HorizontalAlignment="Center" TextAlignment="Center" TextWrapping="Wrap"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    <Button x:Name="AddButton" HorizontalAlignment="Center" Margin="0,8,0,0"
                            Style="{StaticResource AccentButtonStyle}" Click="OnAddFolders">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <FontIcon Glyph="&#xE8F4;" FontSize="16" />
                            <TextBlock Text="Add folders" />
                        </StackPanel>
                    </Button>
                    <Button x:Name="CancelScanButton" HorizontalAlignment="Center" Content="Stop" Click="OnCancelScan" Visibility="Collapsed" />
                </StackPanel>
            </Grid>

            <!-- Added folders -->
            <Border Style="{StaticResource CardStyle}" Padding="20" Visibility="{x:Bind h:Ui.Show(HasStories), Mode=OneWay}">
                <StackPanel Spacing="8">
                    <Grid>
                        <TextBlock Text="Added folders" Style="{StaticResource BodyStrongTextBlockStyle}" VerticalAlignment="Center" />
                        <TextBlock x:Name="Totals" HorizontalAlignment="Right" VerticalAlignment="Center"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    </Grid>
                    <ItemsControl ItemsSource="{x:Bind Rows}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="vm:StoryRow">
                                <Grid ColumnSpacing="14" Padding="0,8" BorderThickness="0,0,0,1"
                                      BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="24" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <FontIcon Glyph="&#xE8D5;" FontSize="18" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" VerticalAlignment="Center" />
                                    <StackPanel Grid.Column="1" Spacing="2" VerticalAlignment="Center">
                                        <TextBlock Text="{x:Bind Name}" Style="{StaticResource BodyStrongTextBlockStyle}" TextTrimming="CharacterEllipsis" />
                                        <TextBlock Text="{x:Bind Path}" Style="{StaticResource CaptionTextBlockStyle}" TextTrimming="CharacterEllipsis"
                                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}" ToolTipService.ToolTip="{x:Bind Path}" />
                                    </StackPanel>
                                    <TextBlock Grid.Column="2" Text="{x:Bind Counts}" VerticalAlignment="Center"
                                               Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                    <Button Grid.Column="3" Style="{StaticResource SubtleButtonStyleUB}" Click="OnRemove"
                                            ToolTipService.ToolTip="Remove from the list (nothing on disk changes)"
                                            AutomationProperties.Name="Remove folder">
                                        <FontIcon Glyph="&#xE711;" FontSize="14" />
                                    </Button>
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right" Margin="0,8,0,0">
                        <Button Content="Clear list" Click="OnClear" />
                        <Button Style="{StaticResource AccentButtonStyle}" Click="OnNext">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <TextBlock Text="Next: Preview" />
                                <FontIcon Glyph="&#xE72A;" FontSize="14" />
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </StackPanel>
            </Border>

            <TextBlock x:Name="FootNote" TextWrapping="Wrap" Style="{StaticResource CaptionTextBlockStyle}"
                       Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                       Text="Files are renamed in place: they stay in their folders, and folders themselves are never renamed. Nothing changes on disk until you click Rename files in Preview." />
        </StackPanel>
    </ScrollViewer>
</Page>
