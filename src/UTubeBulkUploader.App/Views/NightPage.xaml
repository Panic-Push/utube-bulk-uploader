<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="UTubeBulkUploader.Views.NightPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Background="Transparent">

    <ScrollViewer>
        <StackPanel Margin="{StaticResource PageMargin}" Spacing="12" MaxWidth="1000" HorizontalAlignment="Stretch">
            <StackPanel Spacing="4">
                <TextBlock Text="Night mode" Style="{StaticResource TitleTextBlockStyle}" />
                <TextBlock x:Name="Summary" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
            </StackPanel>

            <InfoBar IsOpen="True" IsClosable="True" Severity="Informational"
                     Message="Night mode opens YouTube Studio in its own Chrome window and uploads one batch at a time, with a pause between batches. It stops by itself when Studio says to stop, when it's signed out, or when anything looks unexpected. Someone should keep an eye on it." />

            <!-- Where to upload -->
            <Border Style="{StaticResource CardStyle}">
                <StackPanel Spacing="8">
                    <TextBlock Text="Upload to" Style="{StaticResource BodyStrongTextBlockStyle}" />
                    <RadioButtons x:Name="TargetChoice" SelectionChanged="OnTargetChanged">
                        <RadioButton Content="Practice page: nothing is uploaded and the log isn't changed" Tag="practice" />
                        <RadioButton Content="YouTube Studio: real uploads to the signed-in channel" Tag="real" />
                    </RadioButtons>
                </StackPanel>
            </Border>

            <!-- Chrome -->
            <Border Style="{StaticResource CardStyle}">
                <Grid ColumnSpacing="16">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <FontIcon Glyph="&#xE774;" FontSize="20" VerticalAlignment="Center" />
                    <StackPanel Grid.Column="1" Spacing="2" VerticalAlignment="Center">
                        <TextBlock Text="Night mode's Chrome window" />
                        <TextBlock x:Name="ChromeInfo" Style="{StaticResource CaptionTextBlockStyle}" TextWrapping="Wrap"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    </StackPanel>
                    <Button Grid.Column="2" x:Name="OpenChromeButton" Content="Open Chrome" Click="OnOpenChrome" VerticalAlignment="Center" />
                </Grid>
            </Border>

            <!-- Run -->
            <Border Style="{StaticResource CardStyle}" Padding="20">
                <StackPanel Spacing="12">
                    <Grid>
                        <StackPanel Spacing="4">
                            <TextBlock x:Name="StatusTitle" Text="Ready" Style="{StaticResource SubtitleTextBlockStyle}" />
                            <TextBlock x:Name="StatusDetail" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" />
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right" VerticalAlignment="Top">
                            <Button x:Name="StartButton" Style="{StaticResource AccentButtonStyle}" Click="OnStart">
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <FontIcon Glyph="&#xE768;" FontSize="14" />
                                    <TextBlock Text="Start" />
                                </StackPanel>
                            </Button>
                            <Button x:Name="StopButton" Click="OnStop" IsEnabled="False">
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <FontIcon Glyph="&#xE71A;" FontSize="14" />
                                    <TextBlock Text="Stop" />
                                </StackPanel>
                            </Button>
                        </StackPanel>
                    </Grid>
                    <ProgressBar x:Name="Bar" Maximum="1" Value="0" />
                    <TextBlock x:Name="Counts" Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                </StackPanel>
            </Border>

            <InfoBar x:Name="ResultBar" IsOpen="False" IsClosable="True">
                <InfoBar.ActionButton>
                    <Button x:Name="ScreenshotButton" Content="Open screenshot" Click="OnOpenScreenshot" />
                </InfoBar.ActionButton>
            </InfoBar>

            <TextBlock Text="Activity" Style="{StaticResource BodyStrongTextBlockStyle}" Margin="0,8,0,0" />
            <Border Style="{StaticResource CardStyle}" Padding="12">
                <ItemsControl x:Name="Activity">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="x:String">
                            <TextBlock Text="{x:Bind}" TextWrapping="Wrap" Margin="0,3" IsTextSelectionEnabled="True" />
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </Border>
        </StackPanel>
    </ScrollViewer>
</Page>
