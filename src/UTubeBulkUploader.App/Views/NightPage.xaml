<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="UTubeBulkUploader.Views.NightPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Background="Transparent">

    <ScrollViewer>
        <StackPanel Margin="{StaticResource PageMargin}" Spacing="12" MaxWidth="1000" HorizontalAlignment="Stretch">
            <StackPanel Spacing="4">
                <TextBlock Text="Night mode" Style="{StaticResource TitleTextBlockStyle}" />
                <TextBlock x:Name="Summary" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
            </StackPanel>

            <InfoBar IsOpen="True" IsClosable="True" Severity="Informational"
                     Message="Night mode opens YouTube Studio in its own Chrome window and uploads the waiting clips one at a time, like a person would: Create, Upload videos, title (the file name), description (file name and upload date), not made for kids, Private. It waits on the details screen until Studio says Upload complete, then saves and moves on. A video still not uploaded after 12 minutes is saved anyway and tried again next run; 3 in a row stop the night. It also stops when Studio says to stop, when it's signed out, or when anything looks unexpected." />

            <!-- Chrome -->
            <Border Style="{StaticResource CardStyle}">
                <Grid ColumnSpacing="16">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <FontIcon Glyph="&#xE774;" FontSize="20" VerticalAlignment="Center" />
                    <StackPanel Grid.Column="1" Spacing="2" VerticalAlignment="Center">
                        <TextBlock Text="Night mode's Chrome window" />
                        <TextBlock x:Name="ChromeInfo" Style="{StaticResource CaptionTextBlockStyle}" TextWrapping="Wrap"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    </StackPanel>
                    <Button Grid.Column="2" x:Name="OpenChromeButton" Content="Sign in" Click="OnOpenChrome" VerticalAlignment="Center" />
                </Grid>
            </Border>

            <!-- Run -->
            <Border Style="{StaticResource CardStyle}" Padding="20">
                <StackPanel Spacing="12">
                    <Grid>
                        <StackPanel Spacing="4">
                            <TextBlock x:Name="StatusTitle" Text="Ready" Style="{StaticResource SubtitleTextBlockStyle}" />
                            <TextBlock x:Name="StatusDetail" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" />
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right" VerticalAlignment="Top">
                            <Button x:Name="StartButton" Style="{StaticResource AccentButtonStyle}" Click="OnStart">
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <FontIcon Glyph="&#xE768;" FontSize="14" />
                                    <TextBlock Text="Start" />
                                </StackPanel>
                            </Button>
                            <Button x:Name="StopButton" Click="OnStop" IsEnabled="False">
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <FontIcon Glyph="&#xE71A;" FontSize="14" />
                                    <TextBlock x:Name="StopLabel" Text="Stop" />
                                </StackPanel>
                            </Button>
                        </StackPanel>
                    </Grid>
                    <ProgressBar x:Name="Bar" Maximum="1" Value="0" />
                    <!-- Upload counter -->
                    <Grid ColumnSpacing="8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition /><ColumnDefinition /><ColumnDefinition /><ColumnDefinition />
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock x:Name="StatRun" Text="0" Style="{StaticResource TitleTextBlockStyle}" />
                            <TextBlock Text="Uploaded this run" Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        </StackPanel>
                        <StackPanel Grid.Column="1">
                            <TextBlock x:Name="StatToday" Text="0" Style="{StaticResource TitleTextBlockStyle}" />
                            <TextBlock Text="Uploaded today" Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        </StackPanel>
                        <StackPanel Grid.Column="2">
                            <TextBlock x:Name="StatFailed" Text="0" Style="{StaticResource TitleTextBlockStyle}" />
                            <TextBlock Text="Failed this run" Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        </StackPanel>
                        <StackPanel Grid.Column="3">
                            <TextBlock x:Name="StatLeft" Text="0" Style="{StaticResource TitleTextBlockStyle}" />
                            <TextBlock Text="Still waiting" Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        </StackPanel>
                    </Grid>
                </StackPanel>
            </Border>

            <InfoBar x:Name="ResultBar" IsOpen="False" IsClosable="True">
                <InfoBar.ActionButton>
                    <Button x:Name="ScreenshotButton" Content="Open screenshot" Click="OnOpenScreenshot" />
                </InfoBar.ActionButton>
            </InfoBar>

            <TextBlock Text="Activity" Style="{StaticResource BodyStrongTextBlockStyle}" Margin="0,8,0,0" />
            <Border Style="{StaticResource CardStyle}" Padding="12">
                <ItemsControl x:Name="Activity">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="x:String">
                            <TextBlock Text="{x:Bind}" TextWrapping="Wrap" Margin="0,3" IsTextSelectionEnabled="True" />
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </Border>
        </StackPanel>
    </ScrollViewer>
</Page>
